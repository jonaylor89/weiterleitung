{
  "db_name": "SQLite",
  "query": "\n        SELECT\n            m.mailbox_id, m.email, m.is_default, m.created_at,\n            COUNT(a.alias_id) AS alias_count\n        FROM mailboxes m\n        LEFT JOIN aliases a ON a.mailbox_id = m.mailbox_id\n        GROUP BY m.mailbox_id\n        ORDER BY m.is_default DESC, m.email ASC\n        ",
