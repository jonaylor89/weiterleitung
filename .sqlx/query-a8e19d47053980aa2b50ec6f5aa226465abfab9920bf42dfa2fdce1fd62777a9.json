  "query": "\n        SELECT\n            a.alias_id, a.address, a.mailbox_id, a.note, a.enabled,\n            a.forward_count, a.reply_count, a.blocked_count,\n            a.created_at, a.last_used_at,\n            m.email AS mailbox_email\n        FROM aliases a\n        JOIN mailboxes m ON m.mailbox_id = a.mailbox_id\n        WHERE a.address = ?\n        ",
